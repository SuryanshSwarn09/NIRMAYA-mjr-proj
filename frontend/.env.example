# ==============================================================================
# NIRMAYA Frontend Environment Configuration Template
# Copy this file to .env.local and configure local/production values
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Storage (Frontend Public Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Health Interoperability Node Identification
NEXT_PUBLIC_NODE_ID=NIRMAYA-NODE-01
NEXT_PUBLIC_ENVIRONMENT=development
