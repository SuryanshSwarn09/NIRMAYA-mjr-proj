# ==============================================================================
# NIRMAYA Backend Environment Configuration Template
# Copy this file to .env and configure local/production values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME=NIRMAYA

# Core Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-nirmaya-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nirmaya
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=False

# Supabase Auth & Storage Integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Healthcare Standards & Interoperability
FHIR_VERSION=R4
ABDM_SANDBOX_ENABLED=True

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
